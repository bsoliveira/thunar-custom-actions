#!/usr/bin/env bash
#
# Description: Remove metadata from JPEG, PNG, and WebP image file(s).
# Dependencies: ImageMagick

set -u

usage() {
    echo "Usage: $(basename "$0") FILE [FILE ...]"
    echo
    echo "Remove metadata from JPEG, PNG, and WebP image file(s)."
    echo
    echo "Arguments:"
    echo "  FILE    JPEG, PNG, or WebP image file(s)"
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

for input_file in "$@"; do

    if [[ ! -f "$input_file" ]]; then
        echo "Skipped: file not found: $input_file"
        continue
    fi

    extension="${input_file##*.}"
    extension="${extension,,}"

    case "$extension" in
        jpg|jpeg)
            output_file="${input_file%.*}_clean.jpg"
            ;;

        png)
            output_file="${input_file%.*}_clean.png"
            ;;

        webp)
            output_file="${input_file%.*}_clean.webp"
            ;;

        *)
            echo "Skipped: unsupported format (only JPEG, PNG, and WebP are supported): $(basename "$input_file")"
            continue
            ;;
    esac

    if [[ -e "$output_file" ]]; then
        echo "Skipped: output file already exists: $(basename "$output_file")"
        continue
    fi

    echo "Removing metadata: $(basename "$input_file")"

    if convert "$input_file" \
        -strip \
        "$output_file"
    then
        echo "Done: $(basename "$output_file")"
    else
        rm -f -- "$output_file"
        echo "Error: failed to remove metadata: $(basename "$input_file")"
    fi

    echo
done