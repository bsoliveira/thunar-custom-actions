#!/usr/bin/env bash
#
# Description: Extract audio from video file(s) and convert it to MP3.
# Dependencies: ffmpeg

set -u

usage() {
    echo "Usage: $(basename "$0") FILE [FILE ...]"
    echo
    echo "Extract audio from video file(s) and convert it to MP3."
    echo
    echo "Arguments:"
    echo "  FILE    Video file(s) to process"
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

for input_file in "$@"; do

    if [[ ! -f "$input_file" ]]; then
        echo "Skipped: file not found: $input_file"
        continue
    fi

    output_file="${input_file%.*}.mp3"

    if [[ -e "$output_file" ]]; then
        echo "Skipped: output file already exists: $(basename "$output_file")"
        continue
    fi

    echo "Extracting audio: $(basename "$input_file")"

    if ffmpeg -i "$input_file" \
        -vn \
        -c:a libmp3lame \
        -q:a 2 \
        "$output_file"
    then
        echo "Done: $(basename "$output_file")"
    else
        rm -f -- "$output_file"
        echo "Error: failed to extract audio: $(basename "$input_file")"
    fi

    echo
done