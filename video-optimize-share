#!/usr/bin/env bash
#
# Description: Optimize video file(s) for sharing.
# Dependencies: ffmpeg

set -u

usage() {
    echo "Usage: $(basename "$0") FILE [FILE ...]"
    echo
    echo "Optimize video file(s) for sharing."
    echo
    echo "Arguments:"
    echo "  FILE    Video file(s) to optimize"
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

for input_file in "$@"; do

    if [[ ! -f "$input_file" ]]; then
        echo "Skipped: file not found: $input_file"
        continue
    fi

    output_file="${input_file%.*}_min.mp4"

    if [[ -e "$output_file" ]]; then
        echo "Skipped: output file already exists: $(basename "$output_file")"
        continue
    fi

    echo "Optimizing: $(basename "$input_file")"

    if ffmpeg -i "$input_file" \
        -vf "scale='min(720,iw)':-2" \
        -c:v libx264 \
        -profile:v main \
        -level 4.0 \
        -pix_fmt yuv420p \
        -crf 26 \
        -preset medium \
        -c:a aac \
        -b:a 128k \
        -movflags +faststart \
        "$output_file"
    then
        echo "Done: $(basename "$output_file")"
    else
        rm -f -- "$output_file"
        echo "Error: failed to optimize: $(basename "$input_file")"
    fi

    echo
done