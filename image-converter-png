#!/usr/bin/env bash
#
# Description: Convert image file(s) to PNG.
# Dependencies: ImageMagick

set -u

usage() {
    echo "Usage: $(basename "$0") FILE [FILE ...]"
    echo
    echo "Convert image file(s) to PNG."
    echo
    echo "Arguments:"
    echo "  FILE    Image file(s) to convert"
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

for input_file in "$@"; do

    if [[ ! -f "$input_file" ]]; then
        echo "Skipped: file not found: $input_file"
        continue
    fi

    if [[ "${input_file,,}" == *.png ]]; then
        echo "Skipped: already a PNG: $(basename "$input_file")"
        continue
    fi

    output_file="${input_file%.*}.png"

    if [[ -e "$output_file" ]]; then
        echo "Skipped: output file already exists: $(basename "$output_file")"
        continue
    fi

    echo "Converting: $(basename "$input_file")"

    if convert "$input_file" "$output_file"; then
        echo "Done: $(basename "$output_file")"
    else
        rm -f -- "$output_file"
        echo "Error: failed to convert: $(basename "$input_file")"
    fi

    echo
done